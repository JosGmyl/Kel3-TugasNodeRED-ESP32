    {
        "id": "fn_parse_temp",
        "type": "function",
        "z": "flow_iot_gedung",
        "name": "Ambil Nama Ruang",
        "func": "const parts = msg.topic.split(\"/\");\nmsg.topic = parts[2];               // \"ruang1\"..\"ruang4\" jadi nama garis\nmsg.payload = Number(msg.payload);  // teks -> angka\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 860,
        "y": 160,
        "wires": [
            [
                "chart_suhu"
            ]
        ]
    },
    {
